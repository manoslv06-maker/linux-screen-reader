#!/usr/bin/make -f
# Empacota com pybuild (pyproject) e instala os arquivos de sistema.
# Build: copie packaging/debian para ./debian e rode dpkg-buildpackage -b -us -uc.
export PYBUILD_NAME=nvda-linux
# Os testes rodam fora do pacote (eles usam fakes e não precisam de nada instalado).
export PYBUILD_DISABLE=test

%:
	dh $@ --buildsystem=pybuild

# A unidade systemd --user vem desligada: cada usuário ativa a sua.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable

override_dh_auto_install:
	dh_auto_install
	install -Dm644 packaging/systemd/nvda-linux.service debian/nvda-linux/usr/lib/systemd/user/nvda-linux.service
	install -Dm644 packaging/udev/99-nvda-input.rules debian/nvda-linux/usr/lib/udev/rules.d/99-nvda-input.rules
	install -Dm644 packaging/udev/nvda-linux-uinput.conf debian/nvda-linux/usr/lib/modules-load.d/nvda-linux-uinput.conf
	install -Dm644 packaging/env/50-nvda-linux-a11y.conf debian/nvda-linux/usr/lib/environment.d/50-nvda-linux-a11y.conf
	install -Dm755 packaging/env/nvda-linux-a11y-env.sh debian/nvda-linux/usr/bin/nvda-linux-a11y-env
	# Início automático é opcional: o usuário copia para ~/.config/autostart
	# (ou usa systemctl --user enable nvda-linux.service). Nada sobe sozinho.
	install -Dm644 packaging/autostart/nvda-linux.desktop debian/nvda-linux/usr/share/nvda-linux/autostart/nvda-linux.desktop
	install -Dm644 docs/platform/README.md debian/nvda-linux/usr/share/doc/nvda-linux/PLATFORM.md
